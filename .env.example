# Copy to .env and edit. docker compose reads it automatically.

# Host folder for audio, transcripts, logs and state.db. Use a local drive
# outside OneDrive/Dropbox; the full backlog needs ~70 GB.
MLA_HOST_DATA_DIR=D:/mlarchive-data

# If `status` or the service logs show "database is locked" or "disk I/O error",
# keep the SQLite file on a Docker volume instead of the host folder:
# MLA_STATE_DB=/state/state.db

# Any setting from config.example.toml can be overridden as MLA_<NAME>:
# MLA_PROCESS_SINCE=2026-01-01
# MLA_FETCH_WORKERS=2
# MLA_WHISPER_DEVICE=auto
